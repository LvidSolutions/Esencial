# Public static consent configuration. Enable only after owner/legal approval.
COOKIEBOT_CBID=00000000-0000-0000-0000-000000000000
CONSENT_NOTICE_VERSION=replace-with-approved-version
CONSENT_CONTROLLER_NAME=replace-with-approved-controller-name
CONSENT_PRIVACY_URL=replace-with-approved-https-url
CONSENT_ANALYTICS_RETENTION=replace-with-approved-analytics-retention
CONSENT_CHOICE_RETENTION=replace-with-approved-choice-retention
CONSENT_CHOICE_RETENTION_DAYS=replace-with-approved-integer-1-to-365

# Sanity. Real tokens belong only in ignored .env.local / provider secret stores.
SANITY_PROJECT_ID=g6xm8j7l
SANITY_DATASET=production
SANITY_API_TOKEN=replace-with-a-project-robot-token
SANITY_PREVIEW_TOKEN=replace-with-a-server-only-preview-token

# Studio -> protected staging preview. This value is public configuration, not a secret.
SANITY_STUDIO_PREVIEW_ORIGIN=https://esencial-staging-lvid-s-projects.vercel.app
CMS_ORIGIN=https://esencial-cms.sanity.studio

# Server-only Vercel Web Analytics access. Never expose or commit the token.
VERCEL_ANALYTICS_TOKEN=replace-with-a-vercel-read-token
VERCEL_ANALYTICS_TEAM_ID=team_WYfEJ9qwRDceT63OMREpUQYX
VERCEL_ANALYTICS_PROJECT_ID=prj_tRSkIB76x7SJrOxCptzlA0WwNwPM

# Add Search Console only after the production-domain property is verified and access is approved.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:esencial.se
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
