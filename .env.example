# Public static tracking configuration. Set these only in Vercel for staging/production.
MATOMO_TRACKER_URL=https://your-account.matomo.cloud/matomo.php
MATOMO_SITE_ID=1
COOKIEBOT_CBID=00000000-0000-0000-0000-000000000000

# Server-only analytics proxy configuration. Never expose or commit the token.
MATOMO_URL=https://your-account.matomo.cloud
MATOMO_API_TOKEN=replace-with-a-read-only-token
CMS_ORIGIN=https://esencial-cms.sanity.studio
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
